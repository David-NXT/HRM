@page "/profile-update-review"
@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Nhân sự - Duyệt cập nhật hồ sơ</title>
    <style>
        body{font:15px Segoe UI,Arial;background:#f3f6fa;color:#182230;margin:0}header{background:#12304a;color:#fff;padding:20px max(20px,calc((100% - 1100px)/2))}header a{color:#fff;margin-left:18px}main{max-width:1100px;margin:25px auto;padding:0 20px}.card{background:#fff;border:1px solid #dce4ec;border-radius:9px;padding:18px;margin-bottom:16px}input,select,textarea,button{font:inherit;padding:8px;border:1px solid #c7d2de;border-radius:5px}button{background:#1769aa;color:white;cursor:pointer}.status{min-height:22px;color:#526274}.bar{display:flex;gap:8px;align-items:end}.bar>*{flex:1}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;padding:9px;border-bottom:1px solid #e6ebf0}dl{display:grid;grid-template-columns:180px 1fr;gap:8px}dt{font-weight:600}dd{margin:0;overflow-wrap:anywhere}.files button{margin:3px}.changed{background:#fff7df;padding:8px;border-radius:4px}@@media(max-width:700px){.bar{display:grid}dl{grid-template-columns:1fr}}
    </style>
</head>
<body>
<header><strong>Nhân sự - Duyệt yêu cầu cập nhật hồ sơ</strong><a href="/">Hồ sơ nhân viên</a><a href="/profile-updates">Trang cá nhân của nhân viên</a></header>
<main>
    <p id="status" class="status" role="status"></p>
    <section class="card"><div class="bar"><label>Trạng thái<select id="statusFilter"><option value="PENDING">Chờ duyệt</option><option value="NEED_INFO">Cần bổ sung thông tin</option><option value="APPROVED">Đã chấp thuận</option><option value="REJECTED">Đã từ chối</option><option value="CANCELLED">Đã hủy</option></select></label><button id="refresh" type="button">Tải lại</button><label>Yêu cầu<select id="requestSelect"><option value="">Chọn yêu cầu</option></select></label></div></section>
    <section class="card"><h2>Xét duyệt cập nhật hồ sơ</h2><p id="employeeSummary"></p><h3>Hồ sơ hiện tại</h3><dl id="currentProfile"></dl><h3>Nội dung đề xuất</h3><dl id="changes"></dl><div id="files" class="files"></div></section>
    <section class="card"><h2>Quyết định xử lý</h2><div class="bar"><label>Quyết định<select id="decision"><option value="APPROVE">Chấp thuận</option><option value="REJECT">Từ chối</option><option value="REQUEST_MORE_INFO">Yêu cầu bổ sung thông tin</option></select></label><label>Lý do (bắt buộc khi từ chối hoặc yêu cầu bổ sung)<textarea id="reason" maxlength="1000"></textarea></label><button id="submitReview" type="button">Gửi quyết định</button></div></section>
</main>
@await Html.PartialAsync("/Pages/Shared/_HrVietnameseLabels.cshtml")
<script>
const statusBox=document.querySelector('#status'),requestSelect=document.querySelector('#requestSelect');let currentRequest=null;
async function request(url,options={}){const response=await fetch(url,{...options,headers:{'Content-Type':'application/json','X-Role':'HR',...(options.headers||{})}});if(!response.ok){const body=await response.json().catch(()=>null);throw Error(body?.message||`Yêu cầu không thành công (HTTP ${response.status}).`)}return options.download?response.blob():await response.json().catch(()=>null)}
async function load(){try{const status=document.querySelector('#statusFilter').value;const items=await request('/update-requests?status='+encodeURIComponent(status));requestSelect.replaceChildren(new Option('Chọn yêu cầu',''));for(const item of items)requestSelect.add(new Option(`Yêu cầu ${item.profileUpdateRequestId} · Nhân viên ${item.employeeId} · ${hrLabel(item.status)}`,item.profileUpdateRequestId));if(!items.length)statusBox.textContent='Không có yêu cầu ở trạng thái này.';else statusBox.textContent=`Đã tải ${items.length} yêu cầu.`}catch(error){statusBox.textContent=hrErrorMessage(error)}}
function renderChanges(changes,root=document.querySelector('#changes')){root.replaceChildren();for(const [key,value] of Object.entries(changes)){const label=document.createElement('dt');label.textContent=hrFieldLabel(key);const content=document.createElement('dd');content.textContent=hrFieldValue(key,value);content.className='changed';root.append(label,content)}}
async function showRequest(){const id=requestSelect.value;if(!id)return;try{currentRequest=await request(`/update-requests/${id}`);const employee=await request(`/employees/${currentRequest.employeeId}`);document.querySelector('#employeeSummary').textContent=`${employee.employeeCode} — ${employee.fullName} · Yêu cầu ${currentRequest.profileUpdateRequestId} · ${hrLabel(currentRequest.status)}`;renderChanges(currentRequest.changes);renderChanges(employee,document.querySelector('#currentProfile'));const files=document.querySelector('#files');files.replaceChildren();for(const file of currentRequest.attachments){const button=document.createElement('button');button.type='button';button.textContent=`Tải ${file.originalFileName}`;button.onclick=()=>downloadFile(currentRequest.profileUpdateRequestId,file.profileUpdateAttachmentId,file.originalFileName);files.append(button)}document.querySelector('#reason').value=currentRequest.reviewReason||''}catch(error){statusBox.textContent=hrErrorMessage(error)}}
async function downloadFile(requestId,attachmentId,fileName){try{const blob=await request(`/update-requests/${requestId}/attachments/${attachmentId}`,{download:true});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=fileName;link.click();URL.revokeObjectURL(link.href)}catch(error){statusBox.textContent=hrErrorMessage(error)}}
document.querySelector('#refresh').onclick=load;document.querySelector('#statusFilter').onchange=load;requestSelect.onchange=showRequest;document.querySelector('#submitReview').onclick=async()=>{if(!currentRequest){statusBox.textContent='Vui lòng chọn yêu cầu trước.';return}try{await request(`/update-requests/${currentRequest.profileUpdateRequestId}/review`,{method:'POST',body:JSON.stringify({decision:document.querySelector('#decision').value,reason:document.querySelector('#reason').value.trim()||null})});statusBox.textContent='Đã lưu quyết định xử lý.';currentRequest=null;await load();document.querySelector('#changes').replaceChildren();document.querySelector('#files').replaceChildren()}catch(error){statusBox.textContent=hrErrorMessage(error)}};load();
</script>
</body>
</html>
