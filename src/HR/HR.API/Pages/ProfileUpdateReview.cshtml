@page "/profile-update-review"
@{ Layout = null; }
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>HR - Review profile updates</title>
    <style>
        body{font:15px Segoe UI,Arial;background:#f3f6fa;color:#182230;margin:0}header{background:#12304a;color:#fff;padding:20px max(20px,calc((100% - 1100px)/2))}header a{color:#fff;margin-left:18px}main{max-width:1100px;margin:25px auto;padding:0 20px}.card{background:#fff;border:1px solid #dce4ec;border-radius:9px;padding:18px;margin-bottom:16px}input,select,textarea,button{font:inherit;padding:8px;border:1px solid #c7d2de;border-radius:5px}button{background:#1769aa;color:white;cursor:pointer}.status{min-height:22px;color:#526274}.bar{display:flex;gap:8px;align-items:end}.bar>*{flex:1}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;padding:9px;border-bottom:1px solid #e6ebf0}dl{display:grid;grid-template-columns:180px 1fr;gap:8px}dt{font-weight:600}dd{margin:0;overflow-wrap:anywhere}.files button{margin:3px}.changed{background:#fff7df;padding:8px;border-radius:4px}@@media(max-width:700px){.bar{display:grid}dl{grid-template-columns:1fr}}
    </style>
</head>
<body>
<header><strong>HR - Review profile update requests</strong><a href="/">Employee records</a><a href="/profile-updates">Employee self-service</a></header>
<main>
    <p id="status" class="status" role="status"></p>
    <section class="card"><div class="bar"><label>Status<select id="statusFilter"><option value="PENDING">Pending</option><option value="NEED_INFO">Need info</option><option value="APPROVED">Approved</option><option value="REJECTED">Rejected</option><option value="CANCELLED">Cancelled</option></select></label><button id="refresh" type="button">Refresh</button><label>Request<select id="requestSelect"><option value="">Select request</option></select></label></div></section>
    <section class="card"><h2>Review profile update</h2><p id="employeeSummary"></p><h3>Current profile</h3><dl id="currentProfile"></dl><h3>Proposed profile</h3><dl id="changes"></dl><div id="files" class="files"></div></section>
    <section class="card"><h2>Review decision</h2><div class="bar"><label>Decision<select id="decision"><option value="APPROVE">Approve</option><option value="REJECT">Reject</option><option value="REQUEST_MORE_INFO">Request more information</option></select></label><label>Reason (required for reject / more information)<textarea id="reason" maxlength="1000"></textarea></label><button id="submitReview" type="button">Submit decision</button></div></section>
</main>
<script>
const statusBox=document.querySelector('#status'),requestSelect=document.querySelector('#requestSelect');let currentRequest=null;
async function request(url,options={}){const response=await fetch(url,{...options,headers:{'Content-Type':'application/json','X-Role':'HR',...(options.headers||{})}});if(!response.ok){const body=await response.json().catch(()=>null);throw Error(body?.message||response.statusText)}return options.download?response.blob():await response.json().catch(()=>null)}
async function load(){try{const status=document.querySelector('#statusFilter').value;const items=await request('/update-requests?status='+encodeURIComponent(status));requestSelect.replaceChildren(new Option('Select request',''));for(const item of items)requestSelect.add(new Option(`#${item.profileUpdateRequestId} · Employee ${item.employeeId} · ${item.status}`,item.profileUpdateRequestId));if(!items.length)statusBox.textContent='No requests in this state.';else statusBox.textContent=`Loaded ${items.length} requests.`}catch(error){statusBox.textContent=error.message}}
function renderChanges(changes,root=document.querySelector('#changes')){root.replaceChildren();for(const [key,value] of Object.entries(changes)){const label=document.createElement('dt');label.textContent=key;const content=document.createElement('dd');content.textContent=value??'—';content.className='changed';root.append(label,content)}}
async function showRequest(){const id=requestSelect.value;if(!id)return;try{currentRequest=await request(`/update-requests/${id}`);const employee=await request(`/employees/${currentRequest.employeeId}`);document.querySelector('#employeeSummary').textContent=`${employee.employeeCode} — ${employee.fullName} · Request ${currentRequest.profileUpdateRequestId} · ${currentRequest.status}`;renderChanges(currentRequest.changes);renderChanges(employee,document.querySelector('#currentProfile'));const files=document.querySelector('#files');files.replaceChildren();for(const file of currentRequest.attachments){const button=document.createElement('button');button.type='button';button.textContent=`Download ${file.originalFileName}`;button.onclick=()=>downloadFile(currentRequest.profileUpdateRequestId,file.profileUpdateAttachmentId,file.originalFileName);files.append(button)}document.querySelector('#reason').value=currentRequest.reviewReason||''}catch(error){statusBox.textContent=error.message}}
async function downloadFile(requestId,attachmentId,fileName){try{const blob=await request(`/update-requests/${requestId}/attachments/${attachmentId}`,{download:true});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=fileName;link.click();URL.revokeObjectURL(link.href)}catch(error){statusBox.textContent=error.message}}
document.querySelector('#refresh').onclick=load;document.querySelector('#statusFilter').onchange=load;requestSelect.onchange=showRequest;document.querySelector('#submitReview').onclick=async()=>{if(!currentRequest){statusBox.textContent='Select a request first.';return}try{await request(`/update-requests/${currentRequest.profileUpdateRequestId}/review`,{method:'POST',body:JSON.stringify({decision:document.querySelector('#decision').value,reason:document.querySelector('#reason').value.trim()||null})});statusBox.textContent='Decision saved.';currentRequest=null;await load();document.querySelector('#changes').replaceChildren();document.querySelector('#files').replaceChildren()}catch(error){statusBox.textContent=error.message}};load();
</script>
</body>
</html>
