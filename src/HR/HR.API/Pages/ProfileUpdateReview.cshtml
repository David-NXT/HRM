@page "/profile-update-review"
@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Nhân sự - Duyệt cập nhật hồ sơ</title>
    <style>
        body{font:15px Segoe UI,Arial;background:#f3f6fa;color:#182230;margin:0}header{background:#12304a;color:#fff;padding:20px max(20px,calc((100% - 1100px)/2))}header a{color:#fff;margin-left:18px}main{max-width:1100px;margin:25px auto;padding:0 20px}.card{background:#fff;border:1px solid #dce4ec;border-radius:9px;padding:18px;margin-bottom:16px}input,select,textarea,button{font:inherit;padding:8px;border:1px solid #c7d2de;border-radius:5px}button{background:#1769aa;color:white;cursor:pointer}.status{min-height:22px;color:#526274}.bar{display:flex;gap:8px;align-items:end}.bar>*{flex:1}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;padding:9px;border-bottom:1px solid #e6ebf0}dl{display:grid;grid-template-columns:180px 1fr;gap:8px}dt{font-weight:600}dd{margin:0;overflow-wrap:anywhere}.files button{margin:3px}.changed{background:#fff7df;padding:8px;border-radius:4px}@@media(max-width:700px){.bar{display:grid}dl{grid-template-columns:1fr}}
    </style>
</head>
<body>
<header><strong>Nhân sự - Duyệt yêu cầu cập nhật hồ sơ</strong><a href="/">Hồ sơ nhân viên</a><a href="/profile-updates">Trang cá nhân của nhân viên</a></header>
<main>
    <p id="status" class="status" role="status"></p>
    <section class="card"><div class="bar"><label>Trạng thái<select id="statusFilter"><option value="PENDING">Chờ duyệt</option><option value="NEED_INFO">Cần bổ sung thông tin</option><option value="APPROVED">Đã chấp thuận</option><option value="REJECTED">Đã từ chối</option><option value="CANCELLED">Đã hủy</option><option value="ALL">Tất cả trạng thái</option></select></label><button id="refresh" type="button">Tải lại</button><label>Yêu cầu<select id="requestSelect"><option value="">Chọn yêu cầu</option></select></label></div></section>
    <section class="card"><h2>Xét duyệt cập nhật hồ sơ</h2><p id="employeeSummary"></p><h3>Hồ sơ hiện tại</h3><dl id="currentProfile"></dl><h3>Nội dung đề xuất</h3><dl id="changes"></dl><div id="files" class="files"></div></section>
    <section class="card"><h2>Quyết định xử lý</h2><div class="bar"><label>Quyết định<select id="decision"><option value="APPROVE">Chấp thuận</option><option value="REJECT">Từ chối</option><option value="REQUEST_MORE_INFO">Yêu cầu bổ sung thông tin</option></select></label><label>Lý do (bắt buộc khi từ chối hoặc yêu cầu bổ sung)<textarea id="reason" maxlength="1000"></textarea></label><button id="submitReview" type="button">Gửi quyết định</button></div></section>
</main>
@await Html.PartialAsync("/Pages/Shared/_HrVietnameseLabels.cshtml")
<script>
const statusBox=document.querySelector('#status'),requestSelect=document.querySelector('#requestSelect');
let currentRequest=null,profileChanged=false,saving=false,selectionGeneration=0;
async function request(url,options={}){const response=await fetch(url,{...options,headers:{'Content-Type':'application/json','X-Role':'HR',...(options.headers||{})}});if(!response.ok){const body=await response.json().catch(()=>null);throw Error(body?.message||`Yêu cầu không thành công (HTTP ${response.status}).`)}return options.download?response.blob():await response.json().catch(()=>null)}
// Chỉ cho gửi quyết định cho đúng đề xuất đã tải; hồ sơ gốc cũ vẫn có thể trả bổ sung hoặc từ chối.
function updateReviewButton(){document.querySelector('#submitReview').disabled=saving||!currentRequest||currentRequest.status!=='PENDING'||(profileChanged&&document.querySelector('#decision').value==='APPROVE')}
function clearSelection(){currentRequest=null;profileChanged=false;document.querySelector('#employeeSummary').textContent='';document.querySelector('#currentProfile').replaceChildren();document.querySelector('#changes').replaceChildren();document.querySelector('#files').replaceChildren();document.querySelector('#reason').value='';updateReviewButton()}
// Làm mới danh sách đồng thời bỏ phiên bản yêu cầu cũ đang mở để tránh duyệt nhầm sau khi đổi bộ lọc.
async function load(){
    if(saving)return;
    const generation=++selectionGeneration;clearSelection();requestSelect.disabled=true;
    try{const status=document.querySelector('#statusFilter').value;const items=await request('/update-requests?status='+encodeURIComponent(status));if(generation!==selectionGeneration)return;requestSelect.replaceChildren(new Option('Chọn yêu cầu',''));for(const item of items)requestSelect.add(new Option(`Yêu cầu ${item.profileUpdateRequestId} · Nhân viên ${item.employeeId} · ${hrLabel(item.status)}`,item.profileUpdateRequestId));statusBox.textContent=items.length?`Đã tải ${items.length} yêu cầu.`:'Không có yêu cầu ở trạng thái này.'}
    catch(error){if(generation===selectionGeneration)statusBox.textContent=hrErrorMessage(error)}
    finally{if(generation===selectionGeneration)requestSelect.disabled=false}
}
function renderChanges(changes,root=document.querySelector('#changes')){root.replaceChildren();for(const key of ['fullName','dateOfBirth','gender','email','phone','citizenId','address']){const label=document.createElement('dt');label.textContent=hrFieldLabel(key);const content=document.createElement('dd');content.textContent=hrFieldValue(key,changes[key]);content.className='changed';root.append(label,content)}}
// Giữ version của đề xuất đã xem và đối chiếu baseline; bỏ kết quả tải cũ nếu HR đã chọn một yêu cầu khác.
async function showRequest(){
    if(saving)return;
    const id=requestSelect.value,generation=++selectionGeneration;clearSelection();if(!id)return;
    try{
        const selected=await request(`/update-requests/${id}`),employee=await request(`/employees/${selected.employeeId}`);
        if(generation!==selectionGeneration||requestSelect.value!==id)return;
        currentRequest=selected;profileChanged=selected.baseEmployeeVersion!==employee.version;
        document.querySelector('#employeeSummary').textContent=`${employee.employeeCode} — ${employee.fullName} · ${hrLabel(selected.status)}`;
        renderChanges(selected.changes);renderChanges(employee,document.querySelector('#currentProfile'));
        const files=document.querySelector('#files');
        for(const file of selected.attachments){const button=document.createElement('button');button.type='button';button.textContent=`Tải ${file.originalFileName}`;button.onclick=()=>downloadFile(selected.profileUpdateRequestId,file.profileUpdateAttachmentId,file.originalFileName);files.append(button)}
        document.querySelector('#reason').value=selected.reviewReason||'';
        statusBox.textContent=profileChanged?'Hồ sơ đã thay đổi hoặc yêu cầu cũ thiếu phiên bản gốc. Hãy yêu cầu nhân viên bổ sung và gửi lại; chưa thể chấp thuận đề xuất này.':'Đã mở đề xuất và hồ sơ hiện tại để đối chiếu.';
    }catch(error){if(generation===selectionGeneration)statusBox.textContent=hrErrorMessage(error)}
    finally{if(generation===selectionGeneration)updateReviewButton()}
}
async function downloadFile(requestId,attachmentId,fileName){try{const blob=await request(`/update-requests/${requestId}/attachments/${attachmentId}`,{download:true});const link=document.createElement('a');link.href=URL.createObjectURL(blob);link.download=fileName;link.click();URL.revokeObjectURL(link.href)}catch(error){statusBox.textContent=hrErrorMessage(error)}}
// Gửi đúng version HR đã xem; API kiểm tra lại request và hồ sơ trước khi cập nhật cùng một giao dịch.
async function submitReview(){
    if(saving||!currentRequest||requestSelect.value!==currentRequest.profileUpdateRequestId)return;
    const selected=currentRequest,decision=document.querySelector('#decision').value,reason=document.querySelector('#reason').value.trim()||null;
    if(selected.status!=='PENDING'){statusBox.textContent='Yêu cầu không còn chờ xử lý. Hãy tải lại.';return}
    if(decision==='APPROVE'&&profileChanged){statusBox.textContent='Hồ sơ đã thay đổi. Hãy yêu cầu bổ sung trước khi chấp thuận.';return}
    if(decision!=='APPROVE'&&!reason){statusBox.textContent='Cần nhập lý do từ chối hoặc nội dung cần bổ sung.';return}
    saving=true;updateReviewButton();requestSelect.disabled=true;document.querySelector('#statusFilter').disabled=true;
    try{
        await request(`/update-requests/${selected.profileUpdateRequestId}/review`,{method:'POST',body:JSON.stringify({decision,reason,expectedVersion:selected.version})});
        saving=false;await load();statusBox.textContent='Đã lưu quyết định xử lý.';
    }catch(error){statusBox.textContent=hrErrorMessage(error)}
    finally{saving=false;requestSelect.disabled=false;document.querySelector('#statusFilter').disabled=false;updateReviewButton()}
}
document.querySelector('#refresh').onclick=load;document.querySelector('#statusFilter').onchange=load;requestSelect.onchange=showRequest;document.querySelector('#decision').onchange=updateReviewButton;document.querySelector('#submitReview').onclick=submitReview;updateReviewButton();load();
</script>
</body>
</html>
