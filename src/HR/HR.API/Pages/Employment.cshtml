@page "/employment"
@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Nhân sự - Hợp đồng và lịch sử công tác</title>
    <style>
        body{font:15px Segoe UI,Arial;background:#f3f6fa;color:#182230;margin:0}header{background:#12304a;color:#fff;padding:20px max(20px,calc((100% - 1160px)/2))}header a{color:#fff;margin-left:18px}main{max-width:1160px;margin:26px auto;padding:0 20px}.card{background:#fff;border:1px solid #dce4ec;border-radius:9px;padding:18px;margin-bottom:16px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}form{display:grid;gap:9px}label{display:grid;gap:4px}input,select,textarea,button{font:inherit;padding:8px;border:1px solid #c7d2de;border-radius:5px}button{background:#1769aa;color:#fff;cursor:pointer}.secondary{background:#fff;color:#25364a}.danger{background:#a93232}.row{display:flex;gap:8px;align-items:end}.row>*{flex:1}.status{min-height:22px;color:#526274}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;padding:9px;border-bottom:1px solid #e6ebf0}td.actions{white-space:nowrap}@@media(max-width:760px){.grid{grid-template-columns:1fr}.row{display:grid}}
    </style>
</head>
<body>
<header><strong>Nhân sự - Hợp đồng và lịch sử công tác</strong><a href="/">Hồ sơ nhân viên</a><a href="/organization">Cơ cấu tổ chức</a></header>
<main>
    <p id="status" class="status" role="status"></p>
    <section class="card">
        <h2>Chọn nhân viên</h2>
        <div class="row"><label>Tìm nhân viên<input id="employeeKeyword" type="search" placeholder="Mã hoặc họ tên nhân viên"></label><button id="searchEmployees" type="button">Tìm kiếm</button><label>Nhân viên<select id="employeeSelect"><option value="">Chọn nhân viên</option></select></label></div>
    </section>
    <div class="grid">
        <section class="card">
            <h2>Hợp đồng</h2>
            <form id="contractForm">
                <input type="hidden" name="contractId">
                <label>Số hợp đồng<input name="contractNumber" maxlength="50" required></label>
                <label>Loại hợp đồng<input name="contractType" maxlength="50" required></label>
                <div class="row"><label>Ngày bắt đầu<input name="startDate" type="date" required></label><label>Ngày kết thúc (tùy chọn)<input name="endDate" type="date"></label></div>
                <label>Gia hạn hợp đồng<select name="renewalOfContractId"><option value="">Hợp đồng mới</option></select></label>
                <label>Ghi chú<textarea name="notes" maxlength="1000"></textarea></label>
                <div class="row"><button type="submit">Lưu hợp đồng</button><button type="reset" class="secondary">Xóa nội dung</button></div>
            </form>
            <table><thead><tr><th>Hợp đồng</th><th>Thời gian</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="contracts"></tbody></table>
        </section>
        <section class="card">
            <h2>Lịch sử công tác</h2>
            <form id="assignmentForm">
                <label>Phòng ban<select name="departmentId" required><option value="">Chọn phòng ban</option></select></label>
                <label>Chức vụ<select name="positionId" required><option value="">Chọn chức vụ</option></select></label>
                <label>Ngày hiệu lực<input name="effectiveDate" type="date" required></label>
                <label>Ghi chú<textarea name="notes" maxlength="1000"></textarea></label>
                <button type="submit">Ghi nhận phân công</button>
            </form>
            <table><thead><tr><th>Phòng ban</th><th>Chức vụ</th><th>Thời gian</th></tr></thead><tbody id="history"></tbody></table>
        </section>
    </div>
</main>
@await Html.PartialAsync("/Pages/Shared/_HrVietnameseLabels.cshtml")
<script>
const statusBox=document.querySelector('#status'),employeeSelect=document.querySelector('#employeeSelect'),contractForm=document.querySelector('#contractForm');let employees=[],contracts=[],positions=[],loadedEmployeeId=null,selectedEmployeeStatus=null,detailGeneration=0;
async function request(url,options={}){const response=await fetch(url,{...options,headers:{'Content-Type':'application/json','X-Role':'HR',...(options.headers||{})}});const body=await response.json().catch(()=>null);if(!response.ok)throw Error(body?.message||`Yêu cầu không thành công (HTTP ${response.status}).`);return body}
function cell(row,value){const td=document.createElement('td');td.textContent=value??'';row.append(td);return td}
// Tìm lại danh sách thì bỏ lựa chọn/biểu mẫu cũ, tránh lưu hợp đồng của nhân viên trước sang nhân viên vừa chọn.
async function loadEmployees(){const generation=++detailGeneration;loadedEmployeeId=null;selectedEmployeeStatus=null;updateContractActions();contractForm.reset();contracts=[];document.querySelector('#contracts').replaceChildren();document.querySelector('#history').replaceChildren();try{const query=new URLSearchParams({keyword:document.querySelector('#employeeKeyword').value,page:'1',pageSize:'100'});const result=await request('/employees?'+query);if(generation!==detailGeneration)return;employees=result.items;employeeSelect.replaceChildren(new Option('Chọn nhân viên',''));for(const item of employees)employeeSelect.add(new Option(`${item.employeeCode} — ${item.fullName}`,item.employeeId));refreshPositionOptions();statusBox.textContent=`Đã tải ${employees.length} nhân viên.`}catch(error){if(generation===detailGeneration)statusBox.textContent=hrErrorMessage(error)}}
async function loadOrgOptions(){const [departments,positionItems]=await Promise.all([request('/departments'),request('/positions')]);const dept=document.querySelector('[name=departmentId]');positions=positionItems;dept.replaceChildren(new Option('Chọn phòng ban',''));for(const item of departments.filter(item=>item.status==='ACTIVE'))dept.add(new Option(`${item.code} — ${item.name}`,item.departmentId));refreshPositionOptions()}
function refreshPositionOptions(){const pos=document.querySelector('[name=positionId]'),employee=employees.find(item=>item.employeeId===employeeSelect.value),eligible=positions.filter(item=>item.status==='ACTIVE'&&(employee?.employmentType!=='PART_TIME'||item.seniorityLevel==='STAFF'));pos.replaceChildren(new Option(eligible.length?'Chọn chức vụ':employee?.employmentType==='PART_TIME'?'Chưa có chức vụ cấp nhân viên được phân loại':'Chọn nhân viên trước',''));for(const item of eligible)pos.add(new Option(`${item.code} — ${item.name}`,item.positionId))}
function dateRange(start,end){return `${start}${end?` – ${end}`:' – Không thời hạn/chưa kết thúc'}`}
// Chỉ mở thao tác ghi sau khi đã tải đúng nhân viên hiện tại và người đó chưa nghỉ việc.
function updateContractActions(){const enabled=loadedEmployeeId===employeeSelect.value&&selectedEmployeeStatus!=='RESIGNED';contractForm.querySelector('button[type=submit]').disabled=!enabled;document.querySelector('#assignmentForm button[type=submit]').disabled=!enabled}
// Đọc lại trạng thái nhân viên; tách ngày hết hạn đã ký khỏi ngày chấm dứt thực tế và giữ lý do trên danh sách.
async function loadEmployeeDetails(){
    const employeeId=employeeSelect.value,generation=++detailGeneration;
    loadedEmployeeId=null;selectedEmployeeStatus=null;updateContractActions();
    document.querySelector('#contracts').replaceChildren();document.querySelector('#history').replaceChildren();contracts=[];
    contractForm.elements.renewalOfContractId.replaceChildren(new Option('Hợp đồng mới',''));if(!employeeId)return;
    try{
        const [items,history,employee]=await Promise.all([request(`/employees/${employeeId}/contracts`),request(`/employees/${employeeId}/work-history`),request(`/employees/${employeeId}`)]);
        if(generation!==detailGeneration||employeeSelect.value!==employeeId)return;
        contracts=items;loadedEmployeeId=employeeId;selectedEmployeeStatus=employee.status;
        for(const item of contracts){
            const row=document.createElement('tr');cell(row,`${item.contractNumber} — ${item.contractType}`);
            cell(row,dateRange(item.startDate,item.endDate)+(item.actualEndDate?` · Chấm dứt thực tế: ${item.actualEndDate}`:''));
            const stateCell=cell(row,hrLabel(item.status));stateCell.title=item.terminationReason||'';
            if(item.terminationReason){const reason=document.createElement('div');reason.textContent=item.terminationReason;stateCell.append(reason)}
            const actions=cell(row,'');actions.className='actions';
            if(item.status==='ACTIVE'&&employee.status!=='RESIGNED'){
                const edit=document.createElement('button');edit.type='button';edit.className='secondary';edit.textContent='Sửa';edit.onclick=()=>editContract(item);actions.append(edit);
                if(item.endDate)contractForm.elements.renewalOfContractId.add(new Option(`Gia hạn ${item.contractNumber}`,item.contractId));
            }
            document.querySelector('#contracts').append(row);
        }
        for(const item of history){const row=document.createElement('tr');cell(row,`${item.departmentCode} — ${item.departmentName}`);cell(row,`${item.positionCode} — ${item.positionName}`);cell(row,dateRange(item.startDate,item.endDate));document.querySelector('#history').append(row)}
        if(employee.status==='RESIGNED')statusBox.textContent='Nhân viên đã nghỉ việc. Có thể xem lịch sử; không được tạo hoặc sửa hợp đồng/phân công mới.';
    }catch(error){if(generation===detailGeneration)statusBox.textContent=hrErrorMessage(error)}
    finally{if(generation===detailGeneration)updateContractActions()}
}
// Chỉ sửa hợp đồng ACTIVE của nhân viên đang chọn; API tiếp tục kiểm tra lại khi lưu.
function editContract(item){if(selectedEmployeeStatus==='RESIGNED'||loadedEmployeeId!==employeeSelect.value||item.status!=='ACTIVE')return;contractForm.reset();contractForm.elements.contractId.value=item.contractId;for(const key of ['contractNumber','contractType','startDate','endDate','notes'])contractForm.elements[key].value=item[key]??'';contractForm.elements.renewalOfContractId.disabled=true;contractForm.elements.contractNumber.focus()}
document.querySelector('#searchEmployees').onclick=loadEmployees;document.querySelector('#employeeKeyword').onkeydown=event=>{if(event.key==='Enter'){event.preventDefault();loadEmployees()}};employeeSelect.onchange=()=>{contractForm.reset();refreshPositionOptions();loadEmployeeDetails()};
// Lưu hoặc gia hạn theo đúng nhân viên đã tải, không cho gia hạn hợp đồng không thời hạn.
contractForm.onsubmit=async event=>{event.preventDefault();const employeeId=employeeSelect.value;if(!employeeId||loadedEmployeeId!==employeeId){statusBox.textContent='Vui lòng chọn và tải nhân viên trước.';return}if(selectedEmployeeStatus==='RESIGNED'){statusBox.textContent='Không thể tạo hoặc sửa hợp đồng cho nhân viên đã nghỉ việc.';return}const data=Object.fromEntries(new FormData(contractForm)),contractId=data.contractId;const previous=data.renewalOfContractId?contracts.find(item=>item.contractId===data.renewalOfContractId):null;if(!contractId&&data.renewalOfContractId&&(!previous||previous.status!=='ACTIVE'||!previous.endDate)){statusBox.textContent='Chỉ gia hạn hợp đồng ACTIVE có ngày hết hạn xác định.';return}const payload={contractNumber:data.contractNumber,contractType:data.contractType,startDate:data.startDate,endDate:data.endDate||null,notes:data.notes.trim()||null};if(!contractId&&data.renewalOfContractId)payload.renewalOfContractId=data.renewalOfContractId;try{await request(contractId?`/contracts/${contractId}`:`/employees/${employeeId}/contracts`,{method:contractId?'PUT':'POST',body:JSON.stringify(payload)});contractForm.reset();contractForm.elements.renewalOfContractId.disabled=false;await loadEmployeeDetails();statusBox.textContent='Đã lưu hợp đồng.'}catch(error){statusBox.textContent=hrErrorMessage(error)}};
contractForm.onreset=()=>{contractForm.elements.contractId.value='';contractForm.elements.renewalOfContractId.disabled=false};
document.querySelector('#assignmentForm').onsubmit=async event=>{event.preventDefault();const assignmentForm=event.currentTarget;const employeeId=employeeSelect.value;if(!employeeId){statusBox.textContent='Vui lòng chọn nhân viên trước.';return}const data=Object.fromEntries(new FormData(assignmentForm));const payload={departmentId:data.departmentId,positionId:data.positionId,effectiveDate:data.effectiveDate,notes:data.notes.trim()||null};try{await request(`/employees/${employeeId}/work-history`,{method:'POST',body:JSON.stringify(payload)});assignmentForm.reset();await loadEmployeeDetails();statusBox.textContent='Đã ghi nhận phân công công tác.'}catch(error){statusBox.textContent=hrErrorMessage(error)}};
// Mở đúng nhân viên và chỉ chuẩn bị gia hạn cho hợp đồng có hạn còn được phép xử lý.
async function initialize(){updateContractActions();await Promise.all([loadEmployees(),loadOrgOptions()]);const query=new URLSearchParams(location.search),employeeId=query.get('employeeId');if(!employeeId||!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(employeeId))return;if(![...employeeSelect.options].some(option=>option.value===employeeId)){const employee=await request('/employees/'+employeeId);employeeSelect.add(new Option(`${employee.employeeCode} — ${employee.fullName}`,employee.employeeId))}employeeSelect.value=employeeId;contractForm.reset();await loadEmployeeDetails();const renewalId=query.get('renewContractId'),previous=contracts.find(item=>String(item.contractId)===renewalId&&item.status==='ACTIVE'&&item.endDate);if(previous&&selectedEmployeeStatus!=='RESIGNED'){contractForm.elements.renewalOfContractId.value=String(previous.contractId);contractForm.elements.contractType.value=previous.contractType;if(previous.endDate){const date=new Date(previous.endDate+'T00:00:00Z');date.setUTCDate(date.getUTCDate()+1);contractForm.elements.startDate.value=date.toISOString().slice(0,10)}contractForm.elements.contractNumber.focus()}}
initialize().catch(error=>statusBox.textContent=hrErrorMessage(error));
</script>
</body>
</html>
