@page
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nhân sự - Hồ sơ nhân viên</title>
<style>
body{font:15px Segoe UI,Arial;background:#f3f6fa;color:#182230;margin:0}header{background:#12304a;color:white;padding:24px calc((100% - 1160px)/2)}main{max-width:1160px;margin:28px auto;padding:0 20px}.bar,.card{background:white;border:1px solid #dce4ec;border-radius:9px;padding:16px;margin-bottom:14px}.bar{display:flex;gap:9px}input,select,textarea,button{font:inherit;padding:9px;border:1px solid #c7d2de;border-radius:5px}input[type=search]{flex:1}button{background:#1769aa;color:white;cursor:pointer}button.secondary{background:white;color:#25364a}button.danger{background:#a93232}.table{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid #e6ebf0;white-space:nowrap}.actions{display:flex;gap:5px}.status{min-height:24px;color:#526274}dialog{border:0;border-radius:9px;width:min(540px,90vw)}form{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:grid;gap:4px}.wide,.buttons,h2{grid-column:1/-1}.buttons{display:flex;justify-content:flex-end}@@media(max-width:600px){form{grid-template-columns:1fr}.wide,.buttons,h2{grid-column:1}}
</style></head><body><header><h1>Nhân sự - Hồ sơ nhân viên</h1><p>Ứng dụng web nhân sự · <a href="/organization" style="color:white">Cơ cấu tổ chức</a> · <a href="/employment" style="color:white">Hợp đồng và lịch sử công tác</a> · <a href="/contract-expiry" style="color:white">Cảnh báo hợp đồng hết hạn</a> · <a href="/lifecycle" style="color:white">Tiếp nhận / Nghỉ việc</a> · <a href="/profile-updates" style="color:white">Cập nhật hồ sơ của tôi</a> · <a href="/profile-update-review" style="color:white">Duyệt cập nhật hồ sơ</a></p></header><main>
<section class="bar"><input id="keyword" type="search" placeholder="Tìm theo mã, tên, email, điện thoại hoặc CCCD"><button id="search">Tìm kiếm</button><button id="add">Thêm nhân viên</button></section>
<p id="status" class="status"></p><section class="card table"><table><thead><tr><th>Mã</th><th>Tên</th><th>Loại nhân viên</th><th>Ngày sinh</th><th>Giới tính</th><th>Email</th><th>Điện thoại</th><th>CCCD/CMND</th><th>Phòng ban</th><th>Chức vụ</th><th>Lương (toàn thời gian: VND/tháng; bán thời gian: VND/giờ)</th><th>Mã định danh nhân viên (GUID)</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="rows"></tbody></table></section></main>
<dialog id="editor"><form id="employeeForm"><h2 id="formTitle">Thêm nhân viên</h2>
<label>Mã nhân viên<input name="employeeCode" maxlength="20" required></label><label>Họ tên<input name="fullName" maxlength="150" required></label>
<label>Loại nhân viên<select name="employmentType"><option value="FULL_TIME">Toàn thời gian</option><option value="PART_TIME">Bán thời gian</option></select></label><label>Ngày sinh<input name="dateOfBirth" type="date" min="1900-01-01" required></label><label>Giới tính<select name="gender"><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option></select></label>
<label>Email<input name="email" type="email" maxlength="200" required></label><label>Điện thoại<input name="phone" maxlength="20" required></label><label>CCCD/CMND<input name="citizenId" maxlength="12" required></label><label>Lương cơ bản toàn thời gian (VND/tháng)<input name="baseSalary" type="number" min="0" max="9999999999999999.99" step="0.01" value="0" required></label><label>Đơn giá bán thời gian (VND/giờ)<input name="partTimeSalary" type="number" min="0" max="9999999999999999.99" step="0.01" value="0" required></label>
<label class="wide">Địa chỉ<textarea name="address" maxlength="500"></textarea></label><div class="buttons"><button id="cancel" type="button" class="secondary">Hủy</button><button type="submit">Lưu</button></div></form></dialog><dialog id="salaryEditor"><form id="salaryForm"><h2 id="salaryTitle">Cập nhật lương</h2><label id="salaryLabel" class="wide">Lương<input name="salaryAmount" type="number" min="0" max="9999999999999999.99" step="0.01" required></label><div class="buttons"><button id="cancelSalary" type="button" class="secondary">Hủy</button><button type="submit">Lưu</button></div></form></dialog>
@await Html.PartialAsync("/Pages/Shared/_HrVietnameseLabels.cshtml")
<script>
const api="/employees",statusBox=document.querySelector("#status"),rows=document.querySelector("#rows"),dialog=document.querySelector("#editor"),form=document.querySelector("#employeeForm"),salaryDialog=document.querySelector("#salaryEditor"),salaryForm=document.querySelector("#salaryForm");let editingId=null,salaryEmployeeId=null;
async function request(url,options={}){const r=await fetch(url,{...options,headers:{"Content-Type":"application/json","X-Role":"HR",...(options.headers||{})}}),d=await r.json().catch(()=>null);if(!r.ok)throw Error(d?.message||`Yêu cầu không thành công (HTTP ${r.status}).`);return d}
async function load(){try{const q=new URLSearchParams({page:"1",pageSize:"100",keyword:document.querySelector("#keyword").value}),d=await request(api+"?"+q);rows.replaceChildren();for(const e of d.items){const tr=document.createElement("tr");const salary=e.employmentType==="PART_TIME"?e.partTimeSalary:e.baseSalary;for(const v of [e.employeeCode,e.fullName,hrLabel(e.employmentType),new Date(e.dateOfBirth+"T00:00:00").toLocaleDateString('vi-VN'),hrLabel(e.gender),e.email,e.phone,e.citizenId,e.departmentName,e.positionName,new Intl.NumberFormat('vi-VN').format(salary??0),e.employeeId,hrLabel(e.status)]){const td=document.createElement("td");td.textContent=v??"";tr.append(td)}const td=document.createElement("td");td.className="actions";const edit=document.createElement("button");edit.textContent="Sửa hồ sơ";edit.className="secondary";edit.onclick=()=>open(e);td.append(edit);const salaryButton=document.createElement("button");salaryButton.textContent="Cập nhật lương";salaryButton.className="secondary";salaryButton.onclick=()=>openSalary(e);td.append(salaryButton);const deleteButton=document.createElement("button");deleteButton.textContent="Xóa";deleteButton.className="danger";deleteButton.onclick=async()=>{if(!confirm("Xóa vĩnh viễn hồ sơ "+e.employeeCode+"? Chỉ hồ sơ chưa phát sinh dữ liệu nghiệp vụ mới xóa được."))return;try{await request(api+"/"+e.employeeId,{method:"DELETE"});await load()}catch(x){statusBox.textContent=hrErrorMessage(x)}};td.append(deleteButton);if(e.status!=="LOCKED"&&e.status!=="RESIGNED"){const lock=document.createElement("button");lock.textContent="Khóa";lock.className="danger";lock.onclick=async()=>{if(confirm("Khóa hồ sơ "+e.employeeCode+"?")){try{await request(api+"/"+e.employeeId+"/lock",{method:"POST"});load()}catch(x){statusBox.textContent=hrErrorMessage(x)}}};td.append(lock)}tr.append(td);rows.append(tr)}statusBox.textContent="Tổng "+d.total+" nhân viên; đang hiển thị "+d.items.length+" (tối đa 100)."}catch(e){statusBox.textContent=hrErrorMessage(e)}}
function open(e=null){editingId=e?.employeeId??null;form.reset();form.elements.employeeCode.disabled=!!e;form.elements.employmentType.disabled=!!e;form.elements.employmentType.value=e?.employmentType??"FULL_TIME";form.elements.baseSalary.value=e?.baseSalary??0;form.elements.partTimeSalary.value=e?.partTimeSalary??0;form.elements.baseSalary.disabled=!!e;form.elements.partTimeSalary.disabled=!!e;document.querySelector("#formTitle").textContent=e?"Sửa hồ sơ nhân viên":"Thêm nhân viên";if(e){for(const k of ["employeeCode","fullName","gender","email","phone","citizenId","address"])form.elements[k].value=e[k]??"";form.elements.dateOfBirth.value=e.dateOfBirth}dialog.showModal()}
function openSalary(e){salaryEmployeeId=e.employeeId;const isPartTime=e.employmentType==="PART_TIME";salaryForm.elements.salaryAmount.value=isPartTime?(e.partTimeSalary??0):(e.baseSalary??0);document.querySelector("#salaryTitle").textContent=isPartTime?"Cập nhật đơn giá bán thời gian":"Cập nhật lương cơ bản toàn thời gian";document.querySelector("#salaryLabel").firstChild.textContent=isPartTime?"Đơn giá bán thời gian (VND/giờ)":"Lương cơ bản toàn thời gian (VND/tháng)";salaryDialog.dataset.salaryProperty=isPartTime?"partTimeSalary":"baseSalary";salaryDialog.showModal()}document.querySelector("#cancelSalary").onclick=()=>salaryDialog.close();salaryForm.onsubmit=async e=>{e.preventDefault();try{const salary={};salary[salaryDialog.dataset.salaryProperty]=Number(salaryForm.elements.salaryAmount.value);await request(api+"/"+salaryEmployeeId+"/salary",{method:"PUT",body:JSON.stringify(salary)});salaryDialog.close();load()}catch(x){statusBox.textContent=hrErrorMessage(x)}};document.querySelector("#add").onclick=()=>open();document.querySelector("#search").onclick=load;document.querySelector("#keyword").onkeydown=e=>{if(e.key==="Enter")load()};document.querySelector("#cancel").onclick=()=>dialog.close();
form.onsubmit=async e=>{e.preventDefault();const v=Object.fromEntries(new FormData(form));v.address=v.address.trim()||null;if(editingId){delete v.baseSalary;delete v.partTimeSalary;delete v.employeeCode}else if(v.employmentType==="PART_TIME"){v.partTimeSalary=Number(v.partTimeSalary);delete v.baseSalary}else{v.baseSalary=Number(v.baseSalary);delete v.partTimeSalary}const method=editingId?"PUT":"POST",url=editingId?api+"/"+editingId:api;try{await request(url,{method,body:JSON.stringify(v)});dialog.close();load()}catch(x){statusBox.textContent=hrErrorMessage(x)}};load();
</script></body></html>
