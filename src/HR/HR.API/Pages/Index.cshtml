@page
@{ Layout = null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HR - Employee records</title>
<style>
body{font:15px Segoe UI,Arial;background:#f3f6fa;color:#182230;margin:0}header{background:#12304a;color:white;padding:24px calc((100% - 1160px)/2)}main{max-width:1160px;margin:28px auto;padding:0 20px}.bar,.card{background:white;border:1px solid #dce4ec;border-radius:9px;padding:16px;margin-bottom:14px}.bar{display:flex;gap:9px}input,select,textarea,button{font:inherit;padding:9px;border:1px solid #c7d2de;border-radius:5px}input[type=search]{flex:1}button{background:#1769aa;color:white;cursor:pointer}button.secondary{background:white;color:#25364a}button.danger{background:#a93232}.table{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid #e6ebf0;white-space:nowrap}.actions{display:flex;gap:5px}.status{min-height:24px;color:#526274}dialog{border:0;border-radius:9px;width:min(540px,90vw)}form{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:grid;gap:4px}.wide,.buttons,h2{grid-column:1/-1}.buttons{display:flex;justify-content:flex-end}@@media(max-width:600px){form{grid-template-columns:1fr}.wide,.buttons,h2{grid-column:1}}
</style></head><body><header><h1>HR - Employee records</h1><p>Local web application · <a href="/organization" style="color:white">Organization structure</a> · <a href="/employment" style="color:white">Contracts and work history</a> · <a href="/contract-expiry" style="color:white">Contract expiry alerts</a> · <a href="/lifecycle" style="color:white">Onboarding / Offboarding</a> · <a href="/profile-updates" style="color:white">My profile updates</a> · <a href="/profile-update-review" style="color:white">Review profile updates</a></p></header><main>
<section class="bar"><input id="keyword" type="search" placeholder="Search by code, name, email, phone or citizen ID"><button id="search">Search</button><button id="add">Add employee</button></section>
<p id="status" class="status"></p><section class="card table"><table><thead><tr><th>Code</th><th>Name</th><th>Employment type</th><th>Date of birth</th><th>Gender</th><th>Email</th><th>Phone</th><th>Citizen ID</th><th>Department</th><th>Position</th><th>Employee GUID</th><th>Status</th><th>Actions</th></tr></thead><tbody id="rows"></tbody></table></section></main>
<dialog id="editor"><form id="employeeForm"><h2 id="formTitle">Add employee</h2>
<label>Employee code<input name="employeeCode" maxlength="20" required></label><label>Full name<input name="fullName" maxlength="150" required></label>
<label>Employment type<select name="employmentType"><option value="FULL_TIME">Full-time</option><option value="PART_TIME">Part-time</option></select></label><label>Date of birth<input name="dateOfBirth" type="date" min="1900-01-01" required></label><label>Gender<select name="gender"><option value="Male">Male</option><option value="Female">Female</option><option value="Other">Other</option></select></label>
<label>Email<input name="email" type="email" maxlength="200" required></label><label>Phone<input name="phone" maxlength="20" required></label><label>Citizen ID<input name="citizenId" maxlength="12" required></label>
<label class="wide">Address<textarea name="address" maxlength="500"></textarea></label><div class="buttons"><button id="cancel" type="button" class="secondary">Cancel</button><button type="submit">Save</button></div></form></dialog>
<script>
const api="/employees",statusBox=document.querySelector("#status"),rows=document.querySelector("#rows"),dialog=document.querySelector("#editor"),form=document.querySelector("#employeeForm");let editingId=null;
async function request(url,options={}){const r=await fetch(url,{...options,headers:{"Content-Type":"application/json","X-Role":"HR",...(options.headers||{})}}),d=await r.json().catch(()=>null);if(!r.ok)throw Error(d?.message||r.statusText);return d}
async function load(){try{const q=new URLSearchParams({page:"1",pageSize:"100",keyword:document.querySelector("#keyword").value}),d=await request(api+"?"+q);rows.replaceChildren();for(const e of d.items){const tr=document.createElement("tr");for(const v of [e.employeeCode,e.fullName,e.employmentType,new Date(e.dateOfBirth+"T00:00:00").toLocaleDateString(),e.gender,e.email,e.phone,e.citizenId,e.departmentName,e.positionName,e.employeeId,e.status]){const td=document.createElement("td");td.textContent=v??"";tr.append(td)}const td=document.createElement("td");td.className="actions";const edit=document.createElement("button");edit.textContent="Edit";edit.className="secondary";edit.onclick=()=>open(e);td.append(edit);if(e.status!=="LOCKED"&&e.status!=="RESIGNED"){const lock=document.createElement("button");lock.textContent="Lock";lock.className="danger";lock.onclick=async()=>{if(confirm("Lock "+e.employeeCode+"?")){try{await request(api+"/"+e.employeeId+"/lock",{method:"POST"});load()}catch(x){statusBox.textContent=x.message}}};td.append(lock)}tr.append(td);rows.append(tr)}statusBox.textContent="Total "+d.total+"; showing "+d.items.length+" (maximum 100)."}catch(e){statusBox.textContent=e.message}}
function open(e=null){editingId=e?.employeeId??null;form.reset();form.elements.employeeCode.disabled=!!e;form.elements.employmentType.disabled=!!e;form.elements.employmentType.value=e?.employmentType??"FULL_TIME";document.querySelector("#formTitle").textContent=e?"Edit employee":"Add employee";if(e){for(const k of ["employeeCode","fullName","gender","email","phone","citizenId","address"])form.elements[k].value=e[k]??"";form.elements.dateOfBirth.value=e.dateOfBirth}dialog.showModal()}
document.querySelector("#add").onclick=()=>open();document.querySelector("#search").onclick=load;document.querySelector("#keyword").onkeydown=e=>{if(e.key==="Enter")load()};document.querySelector("#cancel").onclick=()=>dialog.close();
form.onsubmit=async e=>{e.preventDefault();const v=Object.fromEntries(new FormData(form));v.address=v.address.trim()||null;const method=editingId?"PUT":"POST",url=editingId?api+"/"+editingId:api;if(editingId)delete v.employeeCode;try{await request(url,{method,body:JSON.stringify(v)});dialog.close();load()}catch(x){statusBox.textContent=x.message}};load();
</script></body></html>
