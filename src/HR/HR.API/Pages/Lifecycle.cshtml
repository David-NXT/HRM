@page "/lifecycle"
@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>HR - Tiếp nhận và nghỉ việc</title>
    <style>
        body{font:15px Segoe UI,Arial;background:#f3f6fa;color:#182230;margin:0}
        header{background:#12304a;color:white;padding:22px max(20px,calc((100% - 1200px)/2))}
        header a{color:white;margin-right:18px}main{max-width:1200px;margin:24px auto;padding:0 20px}
        .grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{background:white;border:1px solid #dce4ec;border-radius:9px;padding:18px;margin-bottom:18px}
        form{display:grid;gap:12px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:grid;gap:4px}.wide{grid-column:1/-1}
        input,select,textarea,button{font:inherit;padding:8px;border:1px solid #c7d2de;border-radius:5px;min-width:0}textarea{min-height:65px}
        button{background:#1769aa;color:white;cursor:pointer}button.secondary{background:white;color:#25364a}button.danger{background:#a93232}
        button:disabled{opacity:.6;cursor:wait}.bar{display:flex;align-items:end;gap:8px}.bar input,.bar label{flex:1}.status{min-height:24px;white-space:pre-wrap}
        .status.error{color:#a93232}.checklist-input{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;margin-bottom:8px}
        .checkbox{display:flex;align-items:center;gap:6px}.table{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid #e6ebf0}
        td textarea{width:95%;min-width:160px}.summary{padding:12px;background:#eef5fb;border-radius:5px;white-space:pre-wrap}.help{color:#526274}
        @@media(max-width:800px){.grid,.fields{grid-template-columns:1fr}.wide{grid-column:auto}.bar{flex-wrap:wrap}.checklist-input{grid-template-columns:1fr auto}.checklist-input input[type=text]{grid-column:1/-1}}
    </style>
</head>
<body>
<header>
    <h1>Tiếp nhận và nghỉ việc</h1>
    <nav><a href="/">Hồ sơ nhân viên</a><a href="/organization">Cơ cấu tổ chức</a><a href="/employment">Hợp đồng và công tác</a></nav>
</header>
<main>
    <p id="status" class="status" role="status" aria-live="polite"></p>
    <div class="grid">
        <section class="card">
            <h2>Tiếp nhận nhân viên</h2>
            <form id="onboardingForm">
                <div class="fields">
                    <label>Mã nhân viên<input name="employeeCode" maxlength="20" required></label>
                    <label>Họ tên<input name="fullName" maxlength="150" required></label>
                    <label>Loại nhân viên<select name="employmentType"><option value="FULL_TIME">Toàn thời gian</option><option value="PART_TIME">Bán thời gian</option></select></label>
                    <label>Lương cơ bản toàn thời gian (VND/tháng)<input name="baseSalary" type="number" min="0" max="9999999999999999.99" step="0.01" value="0" required></label>
                    <label>Đơn giá bán thời gian (VND/giờ)<input name="partTimeSalary" type="number" min="0" max="9999999999999999.99" step="0.01" value="0" required></label>
                    <label>Ngày sinh<input name="dateOfBirth" type="date" min="1900-01-01" required></label>
                    <label>Giới tính<select name="gender"><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option></select></label>
                    <label>Email<input name="email" type="email" maxlength="200" required></label>
                    <label>Số điện thoại<input name="phone" maxlength="20" required></label>
                    <label>CCCD/CMND<input name="citizenId" maxlength="12" required></label>
                    <label>Ngày bắt đầu làm việc<input name="startDate" type="date" required></label>
                    <label>Phòng ban<select name="departmentId" required></select></label>
                    <label>Chức vụ<select name="positionId" required></select></label>
                    <label class="wide">Địa chỉ<textarea name="address" maxlength="500"></textarea></label>
                    <label class="wide">Ghi chú tiếp nhận<textarea name="notes" maxlength="1000"></textarea></label>
                </div>
                <button type="submit">Xác nhận tiếp nhận</button>
            </form>
            <p id="onboardingResult" class="summary" hidden></p>
        </section>
        <section class="card">
            <h2>Mở hồ sơ nghỉ việc</h2>
            <div class="bar"><label>Tìm nhân viên<input id="employeeKeyword" type="search" placeholder="Mã hoặc họ tên"></label><button id="searchEmployees" type="button" class="secondary">Tìm</button></div>
            <form id="offboardingForm">
                <label>Nhân viên<select name="employeeId" required></select></label>
                <label>Ngày làm việc cuối cùng<input name="lastWorkingDate" type="date" required></label>
                <label>Ghi chú<textarea name="notes" maxlength="1000"></textarea></label>
                <div>
                    <h3>Danh sách bàn giao</h3>
                    <p class="help">Nhập từng hạng mục và chọn những mục bắt buộc phải hoàn thành.</p>
                    <div id="checklistInputs"></div>
                    <button id="addChecklistItem" type="button" class="secondary">Thêm hạng mục</button>
                </div>
                <button type="submit">Tạo hồ sơ nghỉ việc</button>
            </form>
        </section>
    </div>
    <section class="card">
        <h2>Theo dõi nghỉ việc</h2>
        <div class="bar">
            <label>Trạng thái<select id="recordStatus"><option value="IN_PROGRESS">Đang xử lý</option><option value="COMPLETED">Đã hoàn tất</option><option value="">Tất cả</option></select></label>
            <label>Hồ sơ<select id="recordSelect"><option value="">Chọn hồ sơ</option></select></label>
            <button id="reloadRecords" type="button" class="secondary">Tải lại</button>
        </div>
        <div id="recordDetails" hidden>
            <p id="recordSummary" class="summary"></p>
            <form id="recordForm">
                <div class="fields">
                    <label>Ngày làm việc cuối cùng<input name="lastWorkingDate" type="date" required></label>
                    <label>Ghi chú<textarea name="notes" maxlength="1000"></textarea></label>
                </div>
                <button id="saveRecord" type="submit" class="secondary">Lưu thông tin nghỉ việc</button>
            </form>
            <h3>Tiến độ bàn giao</h3>
            <div class="table"><table><thead><tr><th>Hoàn thành</th><th>Hạng mục</th><th>Ghi chú</th><th>Thao tác</th></tr></thead><tbody id="checklistRows"></tbody></table></div>
            <p class="help">Xác nhận hoàn tất sẽ chuyển hồ sơ nhân viên sang đã nghỉ việc và đóng quá trình công tác tại ngày làm việc cuối cùng.</p>
            <button id="completeRecord" type="button" class="danger">Xác nhận hoàn tất nghỉ việc</button>
        </div>
    </section>
</main>
@await Html.PartialAsync("/Pages/Shared/_HrVietnameseLabels.cshtml")
<script>
const onboardingForm = document.querySelector('#onboardingForm');
const offboardingForm = document.querySelector('#offboardingForm');
const recordForm = document.querySelector('#recordForm');
const recordSelect = document.querySelector('#recordSelect');
const statusBox = document.querySelector('#status');
let currentRecord = null;
let positions = [];
let busy = false;
const today = new Date().toISOString().slice(0, 10);
onboardingForm.elements.startDate.value = today;
offboardingForm.elements.lastWorkingDate.value = today;

async function request(url, options = {}) {
    const response = await fetch(url, {...options, headers: {'Content-Type': 'application/json', 'X-Role': 'HR'}});
    const body = await response.json().catch(() => null);
    if (!response.ok) {
        const message = body?.message || (body?.errors ? Object.values(body.errors).flat().join(' ') : body?.title) || `Yêu cầu không thành công (HTTP ${response.status}).`;
        throw Error(message);
    }
    return body;
}
async function perform(action) {
    if (busy) return;
    busy = true;
    statusBox.textContent = 'Đang xử lý…';
    statusBox.classList.remove('error');
    document.querySelectorAll('button').forEach(button => button.disabled = true);
    recordSelect.disabled = true;
    document.querySelector('#recordStatus').disabled = true;
    try { await action(); }
    catch (error) { statusBox.textContent = hrErrorMessage(error); statusBox.classList.add('error'); }
    finally {
        busy = false;
        document.querySelectorAll('button').forEach(button => button.disabled = false);
        recordSelect.disabled = false;
        document.querySelector('#recordStatus').disabled = false;
        applyRecordState();
    }
}
function nullable(value) { return value.trim() || null; }
async function loadOptions() {
    const options = await request('/lifecycle/options');
    const departments = onboardingForm.elements.departmentId;
    departments.replaceChildren(new Option('Chọn phòng ban', ''));
    for (const item of options.departments) departments.add(new Option(`${item.code} — ${item.name}`, item.departmentId));
    positions = options.positions;
    updatePositionOptions();
}
function updatePositionOptions() {
    const select = onboardingForm.elements.positionId;
    const partTime = onboardingForm.elements.employmentType.value === 'PART_TIME';
    const eligible = positions.filter(item => !partTime || item.seniorityLevel === 'STAFF');
    select.replaceChildren(new Option(eligible.length ? 'Chọn chức vụ' : 'Chưa có chức vụ cấp nhân viên được phân loại', ''));
    for (const item of eligible) select.add(new Option(`${item.code} — ${item.name}`, item.positionId));
}
async function loadEmployees() {
    const query = new URLSearchParams({keyword: document.querySelector('#employeeKeyword').value, page: '1', pageSize: '100'});
    const data = await request('/employees?' + query);
    const select = offboardingForm.elements.employeeId;
    select.replaceChildren(new Option('Chọn nhân viên', ''));
    for (const employee of data.items.filter(item => item.status !== 'RESIGNED')) {
        select.add(new Option(`${employee.employeeCode} — ${employee.fullName} (${hrLabel(employee.status)})`, employee.employeeId));
    }
}
function addChecklistInput() {
    const root = document.querySelector('#checklistInputs');
    if (root.children.length >= 50) return;
    const row = document.createElement('div'); row.className = 'checklist-input';
    const title = document.createElement('input'); title.type = 'text'; title.maxLength = 200; title.required = true; title.placeholder = 'Tên hạng mục bàn giao'; title.className = 'checklist-title'; title.setAttribute('aria-label', 'Tên hạng mục');
    const label = document.createElement('label'); label.className = 'checkbox';
    const required = document.createElement('input'); required.type = 'checkbox'; required.checked = true; required.className = 'checklist-required';
    label.append(required, document.createTextNode('Bắt buộc'));
    const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'secondary'; remove.textContent = 'Xóa'; remove.onclick = () => row.remove();
    row.append(title, label, remove); root.append(row);
}
// Tiếp nhận hồ sơ và công tác đầu tiên; việc tạo hợp đồng được thực hiện tại trang hợp đồng riêng.
onboardingForm.onsubmit = event => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(onboardingForm));
    const payload = {
        employee: {employeeCode: data.employeeCode, fullName: data.fullName, dateOfBirth: data.dateOfBirth, gender: data.gender, email: data.email, phone: data.phone, citizenId: data.citizenId, address: nullable(data.address), employmentType: data.employmentType,
            ...(data.employmentType === 'PART_TIME' ? {partTimeSalary: Number(data.partTimeSalary)} : {baseSalary: Number(data.baseSalary)})},
        startDate: data.startDate, departmentId: data.departmentId, positionId: data.positionId, notes: nullable(data.notes)
    };
    perform(async () => {
        const result = await request('/onboarding', {method: 'POST', body: JSON.stringify(payload)});
        const summary = document.querySelector('#onboardingResult'); summary.hidden = false;
        summary.textContent = `Đã tiếp nhận ${result.employeeCode} · ${hrLabel(result.employmentType)} · ${hrLabel(result.status)}\nNgày bắt đầu: ${result.startDate}\nMã định danh nhân viên (GUID): ${result.employeeId}`;
        onboardingForm.reset(); onboardingForm.elements.startDate.value = today;
        await loadEmployees(); statusBox.textContent = 'Đã tạo hồ sơ nhân viên và công tác đầu tiên.';
    });
};
onboardingForm.elements.employmentType.addEventListener('change', updatePositionOptions);
offboardingForm.onsubmit = event => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(offboardingForm));
    const checklist = [...document.querySelector('#checklistInputs').children].map(row => ({title: row.querySelector('.checklist-title').value, isRequired: row.querySelector('.checklist-required').checked}));
    perform(async () => {
        const record = await request('/offboarding', {method: 'POST', body: JSON.stringify({employeeId: data.employeeId, lastWorkingDate: data.lastWorkingDate, notes: nullable(data.notes), checklist})});
        document.querySelector('#recordStatus').value = 'IN_PROGRESS';
        await loadRecords(record.offboardingRecordId); statusBox.textContent = 'Đã mở hồ sơ nghỉ việc. Hoàn thành các mục bàn giao trước khi xác nhận.';
    });
};
async function loadRecords(preferredId = recordSelect.value) {
    const status = document.querySelector('#recordStatus').value;
    const records = await request('/offboarding' + (status ? '?status=' + encodeURIComponent(status) : ''));
    recordSelect.replaceChildren(new Option('Chọn hồ sơ', ''));
    for (const record of records) recordSelect.add(new Option(`#${record.offboardingRecordId} · ${record.employeeCode} — ${record.employeeName} · ${hrLabel(record.status)}`, record.offboardingRecordId));
    recordSelect.value = preferredId ? String(preferredId) : '';
    if (recordSelect.value) renderRecord(await request('/offboarding/' + recordSelect.value));
    else { currentRecord = null; document.querySelector('#recordDetails').hidden = true; }
}
function applyRecordState() {
    const completed = currentRecord?.status === 'COMPLETED';
    recordForm.querySelectorAll('input,textarea,button').forEach(control => control.disabled = busy || completed);
    document.querySelector('#completeRecord').disabled = busy || completed || !currentRecord;
    document.querySelectorAll('#checklistRows input,#checklistRows textarea,#checklistRows button').forEach(control => control.disabled = busy || completed);
}
function renderRecord(record) {
    currentRecord = record;
    document.querySelector('#recordDetails').hidden = false;
    document.querySelector('#recordSummary').textContent = `${record.employeeCode} — ${record.employeeName}\nQuy trình: ${hrLabel(record.status)} · Nhân viên: ${hrLabel(record.employeeStatus)}${record.completedAt ? '\nHoàn tất: ' + new Date(record.completedAt).toLocaleString('vi-VN') : ''}`;
    recordForm.elements.lastWorkingDate.value = record.lastWorkingDate;
    recordForm.elements.notes.value = record.notes || '';
    const body = document.querySelector('#checklistRows'); body.replaceChildren();
    for (const item of record.checklist) {
        const row = document.createElement('tr');
        const stateCell = document.createElement('td'); const checkbox = document.createElement('input'); checkbox.type = 'checkbox'; checkbox.checked = item.isCompleted; checkbox.setAttribute('aria-label', `Hoàn thành ${item.title}`); stateCell.append(checkbox);
        const titleCell = document.createElement('td'); titleCell.textContent = item.title + (item.isRequired ? ' (bắt buộc)' : ' (tùy chọn)');
        const noteCell = document.createElement('td'); const note = document.createElement('textarea'); note.maxLength = 1000; note.value = item.completionNote || ''; note.setAttribute('aria-label', `Ghi chú ${item.title}`); noteCell.append(note);
        const actionCell = document.createElement('td'); const save = document.createElement('button'); save.type = 'button'; save.textContent = 'Lưu';
        save.onclick = () => perform(async () => {
            const updated = await request(`/offboarding/${record.offboardingRecordId}/checklist/${item.offboardingChecklistItemId}`, {method: 'PUT', body: JSON.stringify({isCompleted: checkbox.checked, completionNote: nullable(note.value), expectedVersion: record.version})});
            renderRecord(updated); statusBox.textContent = 'Đã cập nhật hạng mục bàn giao.';
        });
        actionCell.append(save); row.append(stateCell, titleCell, noteCell, actionCell); body.append(row);
    }
    applyRecordState();
}
recordForm.onsubmit = event => {
    event.preventDefault(); if (!currentRecord) return;
    const record = currentRecord;
    perform(async () => {
        const updated = await request(`/offboarding/${record.offboardingRecordId}`, {method: 'PUT', body: JSON.stringify({lastWorkingDate: recordForm.elements.lastWorkingDate.value, notes: nullable(recordForm.elements.notes.value), expectedVersion: record.version})});
        renderRecord(updated); statusBox.textContent = 'Đã cập nhật thông tin nghỉ việc.';
    });
};
document.querySelector('#completeRecord').onclick = () => {
    const record = currentRecord; if (!record || !confirm(`Xác nhận ${record.employeeName} hoàn tất nghỉ việc?`)) return;
    perform(async () => {
        const completed = await request(`/offboarding/${record.offboardingRecordId}/complete`, {method: 'POST', body: JSON.stringify({expectedVersion: record.version})});
        document.querySelector('#recordStatus').value = 'COMPLETED';
        await loadRecords(completed.offboardingRecordId); await loadEmployees();
        statusBox.textContent = 'Đã xác nhận nghỉ việc và đóng quá trình công tác.';
    });
};
document.querySelector('#searchEmployees').onclick = () => perform(async () => { await loadEmployees(); statusBox.textContent = 'Đã tải danh sách nhân viên (tối đa 100 kết quả).'; });
document.querySelector('#employeeKeyword').onkeydown = event => { if (event.key === 'Enter') { event.preventDefault(); document.querySelector('#searchEmployees').click(); } };
document.querySelector('#addChecklistItem').onclick = addChecklistInput;
document.querySelector('#recordStatus').onchange = () => perform(async () => { await loadRecords(''); statusBox.textContent = 'Đã tải danh sách hồ sơ.'; });
document.querySelector('#reloadRecords').onclick = () => perform(async () => { await loadRecords(); statusBox.textContent = 'Đã tải lại hồ sơ.'; });
recordSelect.onchange = () => {
    if (busy) return;
    if (!recordSelect.value) { currentRecord = null; document.querySelector('#recordDetails').hidden = true; return; }
    const id = recordSelect.value;
    perform(async () => { renderRecord(await request('/offboarding/' + id)); statusBox.textContent = 'Đã tải hồ sơ nghỉ việc.'; });
};
addChecklistInput();
perform(async () => { await Promise.all([loadOptions(), loadEmployees(), loadRecords('')]); statusBox.textContent = 'Sẵn sàng quản lý tiếp nhận và nghỉ việc.'; });
</script>
</body>
</html>
